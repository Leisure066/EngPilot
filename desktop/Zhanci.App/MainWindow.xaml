<Window x:Class="Zhanci.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="EngPilot · CET-6 单词实验室"
        Width="1320" Height="860"
        MinWidth="1000" MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForeground}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TitleBarHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TitleBarPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButtonClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource CloseHover}" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#C50F1F" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="OverlayButton" TargetType="Button">
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#2B46E8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#1D33C2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar. CaptionHeight makes the empty area draggable and
         gives the window native double-click / Snap Layouts behaviour. -->
    <Border Grid.Row="0"
            Background="{DynamicResource TitleBarBackground}"
            BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Border Width="24" Height="24" CornerRadius="7" Background="#16233D" Margin="0,0,9,0">
            <Image Source="Assets/engpilot-96.png"
                   Width="24"
                   Height="24"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <TextBlock Text="EngPilot"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TitleBarForeground}"
                     VerticalAlignment="Center" />
          <TextBlock Text="CET-6 · WORD LAB"
                     FontSize="9.5"
                     Foreground="{DynamicResource TitleBarMuted}"
                     Margin="9,1,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton"
                  Style="{StaticResource CaptionButton}"
                  Click="Minimize_Click"
                  ToolTip="最小化"
                  Content="&#xE921;" />
          <Button x:Name="MaximizeButton"
                  Style="{StaticResource CaptionButton}"
                  Click="Maximize_Click"
                  ToolTip="最大化"
                  Content="&#xE922;" />
          <Button x:Name="CloseButton"
                  Style="{StaticResource CaptionButtonClose}"
                  Click="Close_Click"
                  ToolTip="关闭"
                  Content="&#xE8BB;" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="WebView" />

      <Grid x:Name="LoadingOverlay" Background="{DynamicResource WindowBackground}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="64" Height="64" CornerRadius="18" Background="#2B46E8" HorizontalAlignment="Center">
            <TextBlock Text="斩"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="LoadingText"
                     Text="正在启动词库…"
                     Margin="0,18,0,0"
                     FontSize="13"
                     Foreground="{DynamicResource TitleBarMuted}"
                     HorizontalAlignment="Center" />
          <ProgressBar IsIndeterminate="True"
                       Width="168"
                       Height="3"
                       Margin="0,14,0,0"
                       Foreground="#2B46E8"
                       Background="#E4E8F4"
                       BorderThickness="0" />
        </StackPanel>
      </Grid>

      <Grid x:Name="ErrorOverlay"
            Background="{DynamicResource WindowBackground}"
            Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    Margin="32">
          <Border Width="56" Height="56" CornerRadius="16" Background="#FFF0F0" HorizontalAlignment="Center">
            <TextBlock Text="!"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#DF5555"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="ErrorTitle"
                     Text="界面没有加载出来"
                     Margin="0,16,0,0"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TitleBarForeground}"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="ErrorDetail"
                     Margin="0,10,0,0"
                     FontSize="12"
                     LineHeight="19"
                     Foreground="{DynamicResource TitleBarMuted}"
                     TextWrapping="Wrap"
                     MaxHeight="220" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="重试" Style="{StaticResource OverlayButton}" Click="Retry_Click" Margin="0,0,10,0" />
            <Button Content="打开日志" Style="{StaticResource OverlayButton}"
                    Background="#E9EBF3" Foreground="#18213C" Click="OpenLogs_Click" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>